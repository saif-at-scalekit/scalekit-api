{
  "$schema": "https://cdn.scalar.com/schema/scalar-config-next.json",
  "scalar": "2.0.0",
  "info": {
    "title": "Scalekit API Documentation",
    "description": "Scalekit API Reference Documentation"
  },
  "siteConfig": {
    "logo": {
      "darkMode": "https://cdn.scalar.com/marketing/landing/logo-dark.svg",
      "lightMode": "https://cdn.scalar.com/marketing/landing/logo-light.svg"
    }
  },
  "navigation": {
    "routes": {
      "/": {
        "type": "group",
        "title": "Scalekit",
        "children": {
          "/": {
            "type": "page",
            "filepath": "docs/content/quickstart.md",
            "title": "Quickstart",
            "icon": "phosphor/regular/fast-forward"
          },
          "/api": {
            "type": "openapi",
            "url": "https://registry.scalar.com/@scalekit-team/apis/scalekit-apis@1.0.0",
            "title": "API Reference",
            "icon": "phosphor/regular/plug",
            "configuration": {
              "hideModels": true
            }
          }
        }
      }
    }
  }
}
