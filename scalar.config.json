{
  "$schema": "https://cdn.scalar.com/schema/scalar-config-next.json",
  "scalar": "2.0.0",
  "info": {
    "title": "Scalekit API Documentation",
    "description": "Complete reference for all Scalekit API endpoints"
  },
  "siteConfig": {
    "logo": {
      "darkMode": "docs/assets/scalekit-api-black.svg",
      "lightMode": "docs/assets/scalekit-api-white.svg"
    }
  },
  "navigation": {
    "routes": {
      "/": {
        "type": "group",
        "title": "Scalekit",
        "children": {
          "/": {
            "type": "page",
            "filepath": "docs/content/quickstart.md",
            "title": "Quickstart",
            "icon": "phosphor/regular/fast-forward"
          },
          "/sdk": {
            "type": "group",
            "title": "SDK References",
            "icon": "phosphor/regular/code",
            "children": {
              "/sdk/node": {
                "type": "page",
                "filepath": "docs/content/sdk/node.md",
                "title": "Node.js",
                "icon": "phosphor/regular/file-code"
              },
              "/sdk/python": {
                "type": "page",
                "filepath": "docs/content/sdk/python.md",
                "title": "Python",
                "icon": "phosphor/regular/file-py"
              },
              "/sdk/go": {
                "type": "page",
                "filepath": "docs/content/sdk/go.md",
                "title": "Go",
                "icon": "phosphor/regular/file-code"
              },
              "/sdk/java": {
                "type": "page",
                "filepath": "docs/content/sdk/java.md",
                "title": "Java",
                "icon": "phosphor/regular/coffee"
              }
            }
          },
          "/api": {
            "type": "openapi",
            "url": "https://registry.scalar.com/@scalekit-team/apis/scalekit-apis@1.0.0",
            "title": "API Reference",
            "icon": "phosphor/regular/plug",
            "config": {
              "agent": {
                "key": "eyJhbGciOiJFZERTQSJ9...",
                "hideAddApi": true
              },
              "theme": "default",
              "layout": "modern",
              "pageTitle": "Scalekit API",
              "favicon": "https://cdn.prod.website-files.com/65b87d98fa638289e10b8f61/67ab35acf2f180e0fe0a94a8_S%20Icon%20-%20Black%20-%2032x32.png",
              "hideTestRequestButton": false,
              "withDefaultFonts": false,
              "hideModels": true,
              "searchHotKey": "p",
              "hideDarkModeToggle": true,
              "darkMode": false,
              "proxyUrl": "https://proxy.scalar.com",
              "defaultOpenAllTags": true,
              "hideClientButton": true,
              "documentDownloadType": "json",
              "servers": [
                {
                  "url": "https://{SCALEKIT_ENVIRONMENT_URL}",
                  "description": "Scalekit Environment",
                  "variables": {
                    "SCALEKIT_ENVIRONMENT_URL": {
                      "default": "your-env.scalekit.com",
                      "description": "Your full Scalekit environment URL (e.g., my-env.scalekit.com or my-env.scalekit.dev)"
                    }
                  }
                }
              ],
              "authentication": {
                "preferredSecurityScheme": "oauth2",
                "securitySchemes": {
                  "oauth2": {
                    "type": "oauth2",
                    "flows": {
                      "clientCredentials": {
                        "tokenUrl": "https://{SCALEKIT_ENVIRONMENT_URL}/oauth/token",
                        "x-scalar-credentials-location": "body",
                        "x-scalar-security-body": {
                          "grant_type": "client_credentials"
                        }
                      }
                    }
                  }
                }
              },
              "hiddenClients": {
                "c": ["libcurl"],
                "csharp": ["httpclient", "restsharp"],
                "clojure": ["clj_http"],
                "dart": ["http"],
                "go": ["native"],
                "http": ["http1.1", "http1", "http2"],
                "java": ["asynchttp", "okhttp", "unirest", "nethttp"],
                "js": ["xhr", "fetch", "axios", "jquery", "ofetch", "request"],
                "kotlin": ["okhttp"],
                "node": ["undici", "axios", "fetch", "ofetch"],
                "objc": ["nsurlsession"],
                "ocaml": ["cohttp"],
                "fsharp": ["httpclient"],
                "php": ["curl", "guzzle"],
                "powershell": ["restmethod", "webrequest"],
                "python": ["python3", "requests", "httpx_sync", "httpx_async"],
                "r": ["httr"],
                "ruby": ["native"],
                "rust": ["reqwest"],
                "shell": ["httpie", "wget"],
                "swift": ["nsurlsession"]
              },
              "customCss": ".introduction-card-item.scalar-reference-intro-clients { display: none; } .scalar-app .narrow-references-container > header.api-reference-toolbar + * > .section-container:first-child { border-top: none !important; } .scalar-sidebar-footer, .sidebar-footer, [class*='powered-by'], [class*='scalar-powered'] { display: none !important; }"
            }
          }
        }
      }
    }
  }
}
